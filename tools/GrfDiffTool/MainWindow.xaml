<Window x:Class="GrfDiffTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ROZero GRF Weekly Diff" Icon="app.ico" Height="680" Width="980" MinHeight="560" MinWidth="780">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="ROZero GRF Weekly Diff" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="GRF file" VerticalAlignment="Center"/><TextBox x:Name="GrfPath" Grid.Column="1" Margin="8,0" Text="D:\RagnarokZero\data.grf"/><Button Grid.Column="2" Content="Browse..." Click="BrowseGrf_Click"/></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Snapshot folder" VerticalAlignment="Center"/><TextBox x:Name="OutputPath" Grid.Column="1" Margin="8,0" Text="D:\Data grf roz\weekly"/><Button Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click"/></Grid>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="RunButton" Content="Run Now" Width="120" Padding="12,7" Click="Run_Click"/><Button x:Name="TaskButton" Content="Create Weekly Task" Margin="10,0,0,0" Padding="12,7" Click="Task_Click"/><TextBlock x:Name="Status" Margin="18,7,0,0" Foreground="#555"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="ProgressText" Text="Ready" VerticalAlignment="Center"/><TextBlock x:Name="ProgressCount" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid><TextBox x:Name="Log" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/></Grid>
  <ProgressBar x:Name="Progress" Grid.Row="4" Height="14" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
 </Grid>
</Window>
