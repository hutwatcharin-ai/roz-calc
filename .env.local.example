NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin of the deployed site. Required at build time: it is what makes
# the OG image URL absolute, and a relative OG path is ignored by every crawler.
NEXT_PUBLIC_SITE_URL=https://example.com

# Cache purge after a deploy (npm run purge). The zone caches HTML for 24 hours
# and a redeploy does not bust it, so without this a deploy ships code nobody
# sees until the next day. The token needs exactly one permission -- Zone >
# Cache Purge, on this zone only. Never the Global API Key.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
